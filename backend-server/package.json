{
  "name": "breakbuddy-backend",
  "version": "1.0.0",
  "description": "BreakBuddy Backend - Express API with Gemini AI",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "npx tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.js --external:express --external:dotenv --external:@google/genai",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
